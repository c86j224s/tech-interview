{
  "name": "tech-interview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "validate": "node scripts/validate-content.mjs",
    "build": "npm run validate && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "npm run test:content && playwright test",
    "test:content": "node --test tests/content.test.mjs",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "astro": "7.3.1",
    "gray-matter": "4.0.3",
    "marked": "17.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "gh-pages": "6.3.0"
  }
}
