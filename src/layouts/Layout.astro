---
import '../styles/global.css';
import '../styles/paper-turn.css';
import { questions } from '../lib/questions.mjs';
const { title = '말로 풀어보는 CS', page = 'practice', currentId = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
const questionUrls = questions.map((question) => ({ id: question.id, url: `${base}/questions/${question.id}/` }));
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="개념을 아는 것에서, 내 말로 설명하는 것으로. 구두 답변과 핵심 점검 포인트로 연습하는 CS 기술 면접." />
    <meta name="theme-color" content="#f8f7f3" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title} · 말로 풀어보는 CS</title>
    <script is:inline>
      try { const theme = localStorage.getItem('cs-theme'); if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme; } catch {}
    </script>
  </head>
  <body data-current-id={currentId}>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <header class="site-header">
      <a class="brand" href={home} aria-label="말로 풀어보는 CS 홈">
        <span class="brand-symbol" aria-hidden="true">cs<span>·</span></span>
        <span>말로 풀어보는 <b>CS</b></span>
      </a>
      <nav aria-label="주요 메뉴">
        <a href={`${base}/practice/`} aria-current={page === 'practice' ? 'page' : undefined}>질문 연습</a>
        <a href={`${base}/library/`} aria-current={page === 'library' ? 'page' : undefined}>전체 목록 <span class="nav-count">{questions.length}</span></a>
      </nav>
      <button class="theme-toggle" type="button" aria-label="화면 테마 전환" title="화면 테마 전환"><span aria-hidden="true">◐</span></button>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><span>한 번에 한 질문, 내 언어로 차근차근.</span><span>CS INTERVIEW NOTES <span aria-hidden="true">↗</span></span></footer>
    <script id="question-routes" type="application/json" set:html={JSON.stringify(questionUrls).replace(/</g, '\\u003c')} />
    <script>
      const themeButton = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const isDark = () => document.documentElement.dataset.theme === 'dark' || (!document.documentElement.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
      const updateThemeLabel = () => themeButton?.setAttribute('aria-label', `${isDark() ? '라이트' : '다크'} 모드로 전환`);
      updateThemeLabel();
      themeButton?.addEventListener('click', () => {
        const theme = isDark() ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('cs-theme', theme); } catch {}
        updateThemeLabel();
      });
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', updateThemeLabel);
      import '../scripts/paper-turn';
    </script>
  </body>
</html>
