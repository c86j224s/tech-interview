---
const { currentId = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const groups = [
  { title: '01 기초 — 왜 이런 구조가 필요한가', items: [
    ['iocp-foundations', '소켓의 기다림에서 IOCP까지'],
    ['tcp', 'TCP 바이트를 메시지로 조립하기'],
    ['io-readiness', '준비 알림과 완료 알림 비교'],
  ] },
  { title: '02 구현 — 연결 하나를 처리하기', items: [
    ['iocp-completion', '포트 연결 · 수신 제출 · 완료 처리'],
    ['acceptex', 'AcceptEx로 새 연결 받기'],
    ['iocp-send', '송신 순서와 버퍼 관리'],
  ] },
  { title: '03 운영 — 여러 연결과 종료 다루기', items: [
    ['iocp-scheduling', '워커 구성과 연결별 실행 순서'],
    ['iocp-shutdown', '취소 · 완료 회수 · 서버 종료'],
  ] },
];
---
<nav class="knowledge-tree" aria-label="IOCP 지식 트리">
  <details open>
    <summary>IOCP <span>기초에서 구현으로</span></summary>
    <p>실제 폴더 경로가 아니라, 이해에 필요한 순서로 묶은 지도입니다.</p>
    <ul>
      {groups.map(group => <li><details open>
        <summary>{group.title}</summary>
        <ul>{group.items.map(([id, title]) => <li>
          <a href={`${base}/notes/${id}/`} aria-current={currentId === id ? 'page' : undefined}>{title}</a>
          {currentId === id && <span class="current-note">현재 글</span>}
        </li>)}</ul>
      </details></li>)}
    </ul>
  </details>
</nav>
<style>
  .knowledge-tree{margin:0 0 28px;padding:20px;border:1px solid var(--line);border-radius:12px;background:var(--paper);font-size:14px;line-height:1.8;overflow-wrap:anywhere}
  summary{cursor:pointer;font-weight:650;padding:4px 0}
  summary span{font-weight:400;color:var(--muted);margin-left:8px}
  p{color:var(--muted);margin:8px 0 14px}
  ul{list-style:none;margin:8px 0;padding-left:18px;border-left:1px solid var(--line)}
  li{position:relative;padding:5px 0 5px 8px}
  li::before{content:'';position:absolute;left:-18px;top:20px;width:18px;border-top:1px solid var(--line)}
  a{color:var(--accent);text-decoration:underline;text-underline-offset:3px}
  a[aria-current=page]{font-weight:700}
  .current-note{display:inline-block;margin-left:8px;font-size:12px;color:var(--muted)}
  summary:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  @media(max-width:620px){.knowledge-tree{padding:16px}ul{padding-left:12px}li::before{left:-12px;width:12px}}
</style>
