---
import Layout from '../layouts/Layout.astro';
import Question from '../components/Question.astro';
import { questions } from '../lib/questions.mjs';
const question = questions.find((item) => item.id === 'async-api-and-blocking') || questions[0];
---
<Layout currentId={question.id}>
  <section class="page-intro"><div><p class="eyebrow">LESS MEMORIZING. MORE UNDERSTANDING.</p><p class="intro-title">개념을 넘어, <em>내 말로.</em></p><p class="intro-description">하루 한 질문부터 시작하는 CS 인터뷰 연습.</p></div><span class="intro-stamp" aria-hidden="true">생각하고<br/><b>말해보기</b><span>✦</span></span></section>
  <Question question={question} />
</Layout>
