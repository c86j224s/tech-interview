---
import Layout from '../../layouts/Layout.astro';
import IocpTree from '../../components/IocpTree.astro';
import { notes, questionsForNote } from '../../lib/notes.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const topics = [...new Set(notes.map((note) => note.topic))];
---
<Layout title="학습 노트" page="notes">
  <section class="notes-intro">
    <span class="eyebrow">UNDERSTAND BEFORE YOU ANSWER</span>
    <h1>답변 너머의 원리, 학습 노트.</h1>
    <p>하나의 주제를 원리부터 차근차근 공부하는 공간입니다. 그림으로 구조를 보고, 표와 예제·슈도코드로 실제 동작을 따라가 보세요. 현재 {notes.length}개 노트가 있으며, 연결된 질문으로 돌아가 배운 내용을 말로 풀어볼 수 있습니다.</p>
    <p><a class="text-link" href={`${base}/notes/coverage/`}>전체 학습 범위와 아직 설명이 필요한 주제 →</a></p>
  </section>
  <IocpTree />
  {topics.map((topic) => <section class="note-practice" aria-label={topic}>
    <h2>{topic}</h2>
    <div class="notes-grid">{notes.filter((note) => note.topic === topic).map((note) => <article class="note-card">
      <span class="note-topic">{note.topic}</span>
      <h2><a href={`${base}/notes/${note.id}/`}>{note.title}</a></h2>
      <p>{note.summary}</p>
      <span class="note-count">{note.diagramCount > 0 && <>그림 {note.diagramCount}개 · </>}연결된 연습 질문 {questionsForNote(note).length}개</span>
    </article>)}</div>
  </section>)}
</Layout>
