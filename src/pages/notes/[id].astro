---
import Layout from '../../layouts/Layout.astro';
import KnowledgeTree from '../../components/KnowledgeTree.astro';
import { notes, questionsForNote } from '../../lib/notes.mjs';
export function getStaticPaths() { return notes.map((note) => ({ params: { id: note.id }, props: { note } })); }
const { note } = Astro.props;
const practice = questionsForNote(note);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title={note.title} page="notes">
  <header class="notes-intro">
    <a class="text-link" href={`${base}/notes/`}>← 학습 노트 목록</a>
    <h1>{note.title}</h1>
    <p>{note.summary}</p>
    <span class="note-topic">{note.topic} · 원리와 예제로 공부하기</span>
  </header>
  <details class="knowledge-navigation" open={false}>
    <summary>기술 지식 트리</summary>
    <KnowledgeTree currentId={note.id} />
  </details>
  <div class="note-layout">
    <article class="note-article"><div class="note-body" set:html={note.html} /></article>
    <nav class="note-toc" aria-label="학습 노트 목차">
      <h2>이 노트에서 배울 것</h2>
      <ol>{note.toc.map((entry) => <li><a href={`#${entry.id}`}>{entry.title}</a></li>)}</ol>
      <a href="#practice-questions">관련 질문으로 연습하기 ↓</a>
    </nav>
  </div>
  <section class="note-practice" id="practice-questions">
    <h2>배운 내용으로 답해 보기</h2>
    <p>직접 연결된 질문과 그 질문에서 확장한 심화 문항입니다. 이 노트가 모든 플랫폼의 세부 계약을 대신하지는 않습니다.</p>
    <ul>{practice.map((question) => <li><a href={`${base}/questions/${question.id}/`}>{question.title}</a></li>)}</ul>
  </section>
</Layout>
