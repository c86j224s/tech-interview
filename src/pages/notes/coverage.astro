---
import Layout from '../../layouts/Layout.astro';
import { studyFamilies, coverageCounts, coverageLabels } from '../../lib/study-coverage.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = [...new Set(studyFamilies.map(({ question }) => question.category))];
---
<Layout title="학습 범위와 남은 주제" page="notes">
  <header class="notes-intro">
    <a class="text-link" href={`${base}/notes/`}>← 학습 노트 목록</a>
    <h1>학습 범위와 남은 주제</h1>
    <p>전체 질문을 빠짐없이 확인하기 위한 작업 목록입니다. 기본 질문과 그 질문에서 확장한 문항을 묶어 놓았으며, 이 묶음이 노트 하나와 대응해야 한다는 뜻은 아닙니다. 같은 원리는 여러 묶음에서 함께 공부할 수 있습니다.</p>
    <p><strong>링크가 있다고 설명이 완료된 것은 아닙니다.</strong> 본문 검토 완료는 명시된 질문 범위에 한해 원리·예제·실패 조건을 확인했다는 뜻이며, 실제 제품에서 실험을 마쳤다는 뜻은 아닙니다. 기존 노트도 이 기준의 별도 판정을 아직 받지 않았다면 검토 대기로 표시합니다.</p>
    <ul class="coverage-counts">{Object.entries(coverageLabels).map(([status, label]) => <li><strong>{coverageCounts[status]}</strong>문항 · {label}</li>)}</ul>
  </header>
  <form class="coverage-controls" role="search" onsubmit="return false">
    <label>주제 또는 질문 찾기<input type="search" id="coverage-search" placeholder="예: 가상 메모리, Kafka, 토큰" /></label>
    <label>설명 상태<select id="coverage-status"><option value="">모든 상태</option>{Object.entries(coverageLabels).map(([status, label]) => <option value={status}>{label}</option>)}</select></label>
  </form>
  <p id="coverage-results" role="status">전체 {studyFamilies.length}개 질문 묶음 · {Object.values(coverageCounts).reduce((sum, count) => sum + count, 0).toLocaleString('ko-KR')}문항</p>
  {categories.map((category) => <section class="coverage-category" data-coverage-category>
    <h2>{category}</h2>
    {studyFamilies.filter(({ question }) => question.category === category).map(({ question, entries }) => <details class="coverage-family" data-coverage-family data-search={entries.map(({ question }) => `${question.id} ${question.title}`).join(' ')}>
      <summary>{question.title} <span>연관 문항 {entries.length}개</span></summary>
      <ul>{entries.map(({ question: item, status, linked, review }) => <li data-coverage-entry data-status={status}>
        <span class="coverage-badge">{coverageLabels[status]}</span>
        <a href={`${base}/questions/${item.id}/`}>{item.title}</a>
        {review && <p>{review.scope} {review.remaining && <strong>남은 범위: {review.remaining}</strong>}</p>}
        {review ? <p>검토 근거: {review.sections.map((section, index) => <><a href={`${base}/notes/${review.noteId}/#${section}`}>본문 {index + 1}</a>{index < review.sections.length - 1 ? ' · ' : ''}</>)}</p>
          : linked.length > 0 && <p>참고 노트: {linked.map((note, index) => <><a href={`${base}/notes/${note.id}/`}>{note.title}</a>{index < linked.length - 1 ? ' · ' : ''}</>)}</p>}
      </li>)}</ul>
    </details>)}
  </section>)}
  <p id="coverage-empty" hidden>일치하는 주제가 없습니다. 검색어나 상태 필터를 바꿔 보세요.</p>
</Layout>
<script>
  const search = document.querySelector<HTMLInputElement>('#coverage-search')!;
  const status = document.querySelector<HTMLSelectElement>('#coverage-status')!;
  const families = [...document.querySelectorAll<HTMLDetailsElement>('[data-coverage-family]')];
  function filter() {
    const terms = search.value.normalize('NFKC').toLocaleLowerCase().split(/\s+/).filter(Boolean);
    let count = 0;
    for (const family of families) {
      const matches = terms.every((term) => family.dataset.search!.normalize('NFKC').toLocaleLowerCase().includes(term));
      let visible = 0;
      for (const entry of family.querySelectorAll<HTMLElement>('[data-coverage-entry]')) {
        entry.hidden = !!status.value && entry.dataset.status !== status.value;
        if (!entry.hidden) visible++;
      }
      family.hidden = !matches || !visible;
      if (!family.hidden) count++;
    }
    document.querySelectorAll<HTMLElement>('[data-coverage-category]').forEach((category) => {
      category.hidden = !category.querySelector('[data-coverage-family]:not([hidden])');
    });
    document.querySelector('#coverage-results')!.textContent = `${count}개 질문 묶음`;
    (document.querySelector('#coverage-empty') as HTMLElement).hidden = count > 0;
  }
  search.addEventListener('input', filter);
  status.addEventListener('change', filter);
</script>
<style>
.coverage-counts{display:flex;flex-wrap:wrap;gap:12px 24px;padding-left:20px;color:var(--muted)}.coverage-counts strong{color:var(--ink);font-size:20px}.coverage-controls{display:flex;flex-wrap:wrap;gap:16px;margin-bottom:20px}.coverage-controls label{display:grid;gap:8px;font-size:13px;flex:1;min-width:0}.coverage-controls input,.coverage-controls select{width:100%;padding:12px;border:1px solid var(--line);border-radius:8px;background:var(--paper);color:var(--ink)}.coverage-category{margin:32px 0}.coverage-category>h2{margin-bottom:16px}.coverage-family{border-bottom:1px solid var(--line);padding-block:15px;line-height:1.8;overflow-wrap:anywhere}.coverage-family summary{cursor:pointer;font-weight:600}.coverage-family summary span{display:block;font-size:12px;font-weight:400;color:var(--muted)}.coverage-family ul{padding-left:20px}.coverage-family li{margin-block:20px}.coverage-family a{color:var(--accent);text-decoration:underline;text-underline-offset:3px}.coverage-family p{font-size:13px;margin-top:8px;color:var(--muted)}.coverage-badge{display:block;color:var(--muted);font-size:12px;margin-bottom:4px}@media(max-width:620px){.coverage-controls{flex-direction:column}}
</style>
